{
  "name": "media-viewer",
  "version": "1.3.0",
  "description": "Media Viewer - 本地图片/视频素材库管理器",
  "main": "./out/main/index.js",
  "author": "Media Viewer",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "node scripts/make-icon.cjs",
    "dist": "electron-vite build && electron-builder --win nsis --x64",
    "postinstall": "node scripts/fix-better-sqlite3.cjs",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.mediaviewer.app",
    "productName": "Media Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Media Viewer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dyf1234567",
        "repo": "media-viewer"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "pinia": "^2.2.0",
    "sharp": "^0.33.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
